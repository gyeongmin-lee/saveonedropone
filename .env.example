# Supabase public browser configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Configure with `wrangler secret put`.
# Never place this value in wrangler.jsonc `vars` or any browser-exposed env.
SUPABASE_SERVICE_ROLE_KEY=

# Product analytics
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare/Wrangler deployment values are managed through Wrangler config,
# `wrangler secret put`, and the Cloudflare dashboard. Do not commit API tokens.
CLOUDFLARE_ACCOUNT_ID=
